# ============================================================
# Equis 环境变量模板
# ------------------------------------------------------------
# 使用方式：
#   1) 复制本文件为 .env（与 config.py 同目录，即 agent/.env）
#   2) 填入你自己的百炼 API Key
#   3) .env 已被 .gitignore 排除，切勿提交或随交付物打包
#
# 安全提示（代码审计结论）：
#   - 绝对不要把 Key 写进任何前端文件（*.html / *.js）。前端一律走后端代理。
#   - 本项目的 Flask 服务默认监听 127.0.0.1，/static/ 下的文件可被同网段读取。
#   - 一旦怀疑泄漏：立刻在百炼控制台吊销该 Key 并重新签发（只删文件无效）。
# ============================================================

# ── 必填：阿里云百炼 API Key（境内，数据不出境）──
BAILIAN_API_KEY=

# ── 可选：百炼应用 ID（使用 Agent App 时才需要）──
BAILIAN_APP_ID=

# ── 可选：模型与引擎覆盖（不填则用 config.py 的默认值）──
# EQUIS_LLM_MODEL=qwen3.8-max          # 主控模型
# EQUIS_VL_MODEL=qwen3-vl-plus        # 视觉主模型
# EQUIS_VL_FALLBACK=qwen3.8-max       # 视觉降级模型
# EQUIS_ASR_MODEL=fun-asr              # 语音识别（境内，替代浏览器 Web Speech）
# EQUIS_TTS_MODEL=cosyvoice-v1         # 语音合成
# EQUIS_T2I_MODEL=wanx2.1-t2i-turbo        # 文生图
# EQUIS_ENGINE=graph                   # graph（默认，LangGraph）| legacy（手写 Coordinator）
# EQUIS_LLM_TIMEOUT=60
# EQUIS_LLM_MAX_TOKENS=2000

# Local development listener
EQUIS_HOST=127.0.0.1
EQUIS_PORT=7860
